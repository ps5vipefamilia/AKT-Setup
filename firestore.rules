rules_version = '2';
// =====================================================================
//  AKT v2.0 · Reglas de Cloud Firestore
//  - Nadie lee ni escribe nada sin cuenta de Google iniciada.
//  - Solo los MIEMBROS aprobados de un equipo leen sus datos.
//  - Los roles (admin, editar todos, editar mi kart) se comprueban AQUÍ.
//  - Un no miembro solo puede crear un equipo nuevo (y ser su admin)
//    o dejar una solicitud de acceso.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teamDoc(t) { return /databases/$(database)/documents/teams/$(t); }
    function userDoc(t) { return /databases/$(database)/documents/teams/$(t)/users/$(request.auth.uid); }
    function member(t)  { return signedIn() && exists(userDoc(t)); }
    function me(t)      { return get(userDoc(t)).data; }
    function admin(t)   { return member(t) && me(t).isAdmin == true; }
    function editAll(t) { return member(t) && (me(t).isAdmin == true || me(t).canEditAll == true); }
    function canEditKart(t, k) { return member(t) && (editAll(t) || me(t).kartId == k); }
    function isStr(v)  { return v is string && v.size() <= 300; }
    function isNum(v)  { return v is number; }
    function inc()     { return request.resource.data; }

    // Bloqueo por defecto
    match /{document=**} { allow read, write: if false; }

    match /teams/{t} {
      allow get:    if member(t);
      allow list:   if false;
      allow create: if signedIn()
                    && inc().adminUid == request.auth.uid
                    && inc().code == t
                    && isStr(inc().nombre)
                    && inc().config is map;
      allow update: if admin(t) && inc().adminUid == resource.data.adminUid;
      allow delete: if false;

      // ---------- miembros ----------
      match /users/{uid} {
        allow get:    if signedIn() && (uid == request.auth.uid || admin(t));
        allow list:   if admin(t);
        allow create: if signedIn()
                      && ((uid == request.auth.uid && get(teamDoc(t)).data.adminUid == request.auth.uid) || admin(t))
                      && isStr(inc().nombre)
                      && inc().isAdmin is bool
                      && inc().canEditAll is bool;
        allow update: if admin(t) && !(uid == request.auth.uid && inc().isAdmin == false);
        allow delete: if admin(t) && uid != request.auth.uid;
      }

      // ---------- solicitudes de acceso ----------
      match /requests/{uid} {
        allow get:    if signedIn() && (uid == request.auth.uid || admin(t));
        allow list:   if admin(t);
        allow create: if signedIn() && uid == request.auth.uid
                      && inc().uid == request.auth.uid
                      && isStr(inc().nombre) && isStr(inc().rol);
        allow update: if false;
        allow delete: if admin(t) || (signedIn() && uid == request.auth.uid);
      }

      // ---------- karts (incluye horas y mantenimiento de freno) ----------
      match /karts/{id} {
        allow read:   if member(t);
        allow create: if admin(t) && isStr(inc().nombre);
        allow update: if canEditKart(t, id) && isStr(inc().nombre);
        allow delete: if false;
      }

      // ---------- circuitos (conocimiento común) ----------
      match /circuitos/{id} {
        allow read:   if member(t);
        allow create, update: if editAll(t)
                      && isStr(inc().nombre) && isNum(inc().longitud)
                      && isNum(inc().pinonRef) && isNum(inc().coronaRef);
        allow delete: if admin(t);
      }

      // ---------- motores (horas, intervalos, historial de cambios) ----------
      match /motores/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, inc().kartId)
                      && isStr(inc().serie) && isStr(inc().apodo)
                      && isNum(inc().horas);
        allow update: if canEditKart(t, resource.data.kartId)
                      && inc().kartId == resource.data.kartId
                      && isNum(inc().horas);
        allow delete: if admin(t);
      }

      // ---------- carburadores (de un kart o del equipo) ----------
      match /carburadores/{id} {
        allow read:   if member(t);
        allow create, update: if isStr(inc().numero)
                      && ((inc().kartId is string && inc().kartId != '' && canEditKart(t, inc().kartId)) || editAll(t));
        allow delete: if admin(t);
      }

      // ---------- sesiones ----------
      match /sesiones/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, inc().kartId)
                      && inc().createdBy == request.auth.uid
                      && isStr(inc().fecha) && isStr(inc().circuitoId)
                      && inc().trans is map && inc().setup is map && inc().carb is map;
        allow update: if canEditKart(t, resource.data.kartId)
                      && inc().kartId == resource.data.kartId
                      && inc().createdBy == resource.data.createdBy;
        allow delete: if canEditKart(t, resource.data.kartId);
      }

      // ---------- setups guardados ----------
      match /setups/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, inc().kartId)
                      && inc().createdBy == request.auth.uid
                      && isStr(inc().nombre) && inc().setup is map;
        allow update: if canEditKart(t, resource.data.kartId);
        allow delete: if canEditKart(t, resource.data.kartId);
      }

      // ---------- calendario de carreras ----------
      match /calendario/{id} {
        allow read:   if member(t);
        allow create, update: if editAll(t) && isStr(inc().campeonato) && isStr(inc().fecha);
        allow delete: if editAll(t);
      }

      // ---------- vídeos y enlaces de referencia ----------
      match /enlaces/{id} {
        allow read:   if member(t);
        allow create, update: if editAll(t) && isStr(inc().titulo) && isStr(inc().url)
                      && inc().url.matches('https?://.*');
        allow delete: if editAll(t);
      }
    }
  }
}
