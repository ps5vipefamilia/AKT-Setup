rules_version = '2';
// =====================================================================
//  AKT · Reglas de Cloud Firestore
//  Principios:
//   - Nadie lee ni escribe nada sin cuenta de Google iniciada.
//   - Solo los MIEMBROS aprobados de un equipo leen sus datos.
//   - Los roles (admin, editar todos, editar mi kart) se comprueban AQUÍ,
//     no en la app.
//   - Un no miembro solo puede: crear un equipo nuevo (y ser su admin) o
//     dejar una solicitud de acceso que el admin aprueba o rechaza.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funciones auxiliares ----------
    function signedIn() { return request.auth != null; }
    function teamDoc(t) { return /databases/$(database)/documents/teams/$(t); }
    function userDoc(t) { return /databases/$(database)/documents/teams/$(t)/users/$(request.auth.uid); }
    function member(t)  { return signedIn() && exists(userDoc(t)); }
    function me(t)      { return get(userDoc(t)).data; }
    function admin(t)   { return member(t) && me(t).isAdmin == true; }
    function editAll(t) { return member(t) && (me(t).isAdmin == true || me(t).canEditAll == true); }
    function canEditKart(t, k) { return member(t) && (editAll(t) || me(t).kartId == k); }
    function isStr(v)  { return v is string && v.size() <= 300; }
    function isNum(v)  { return v is number; }
    function in_(d)    { return request.resource.data; }   // datos entrantes

    // Bloqueo por defecto de todo lo que no esté listado abajo
    match /{document=**} { allow read, write: if false; }

    match /teams/{t} {
      // El doc del equipo solo lo leen sus miembros. Nunca listar equipos.
      allow get:    if member(t);
      allow list:   if false;
      // Crear equipo: cualquier usuario con sesión; queda como admin.
      allow create: if signedIn()
                    && in_(0).adminUid == request.auth.uid
                    && in_(0).code == t
                    && isStr(in_(0).nombre)
                    && in_(0).config is map;
      // Solo el admin cambia nombre/config; nadie cambia el adminUid.
      allow update: if admin(t) && in_(0).adminUid == resource.data.adminUid;
      allow delete: if false;

      // ---------- usuarios (miembros aprobados) ----------
      match /users/{uid} {
        allow get:    if signedIn() && (uid == request.auth.uid || admin(t));
        allow list:   if admin(t);
        // Crear: el fundador se da de alta a sí mismo; después solo el admin aprueba.
        allow create: if signedIn()
                      && ((uid == request.auth.uid && get(teamDoc(t)).data.adminUid == request.auth.uid) || admin(t))
                      && isStr(in_(0).nombre)
                      && in_(0).isAdmin is bool
                      && in_(0).canEditAll is bool;
        // Editar permisos: solo admin, y no puede quitarse a sí mismo el rol de admin.
        allow update: if admin(t) && !(uid == request.auth.uid && in_(0).isAdmin == false);
        allow delete: if admin(t) && uid != request.auth.uid;
      }

      // ---------- solicitudes de acceso ----------
      match /requests/{uid} {
        allow get:    if signedIn() && (uid == request.auth.uid || admin(t));
        allow list:   if admin(t);
        allow create: if signedIn() && uid == request.auth.uid
                      && in_(0).uid == request.auth.uid
                      && isStr(in_(0).nombre) && isStr(in_(0).rol);
        allow update: if false;
        allow delete: if admin(t) || (signedIn() && uid == request.auth.uid);
      }

      // ---------- karts ----------
      match /karts/{id} {
        allow read:   if member(t);
        allow create: if admin(t) && isStr(in_(0).nombre);
        allow update: if canEditKart(t, id) && isStr(in_(0).nombre);
        allow delete: if false;
      }

      // ---------- circuitos (conocimiento común) ----------
      match /circuitos/{id} {
        allow read:   if member(t);
        allow create, update: if editAll(t)
                      && isStr(in_(0).nombre) && isNum(in_(0).longitud)
                      && isNum(in_(0).pinonRef) && isNum(in_(0).coronaRef);
        allow delete: if admin(t);
      }

      // ---------- motores ----------
      match /motores/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, in_(0).kartId)
                      && isStr(in_(0).serie) && isStr(in_(0).apodo);
        allow update: if canEditKart(t, resource.data.kartId)
                      && in_(0).kartId == resource.data.kartId;
        allow delete: if admin(t);
      }

      // ---------- sesiones ----------
      match /sesiones/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, in_(0).kartId)
                      && in_(0).createdBy == request.auth.uid
                      && isStr(in_(0).fecha) && isStr(in_(0).circuitoId)
                      && in_(0).trans is map && in_(0).setup is map && in_(0).carb is map;
        allow update: if canEditKart(t, resource.data.kartId)
                      && in_(0).kartId == resource.data.kartId;
        allow delete: if canEditKart(t, resource.data.kartId);
      }

      // ---------- setups guardados ----------
      match /setups/{id} {
        allow read:   if member(t);
        allow create: if canEditKart(t, in_(0).kartId)
                      && in_(0).createdBy == request.auth.uid
                      && isStr(in_(0).nombre) && in_(0).setup is map;
        allow update: if canEditKart(t, resource.data.kartId);
        allow delete: if canEditKart(t, resource.data.kartId);
      }
    }
  }
}
